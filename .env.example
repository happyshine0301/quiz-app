# 이 파일을 .env.local로 복사해 값을 채웁니다. Vercel에서는 같은 이름으로 환경 변수를 등록합니다.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
TEACHER_EMAIL=
# 서버용 열쇠: 내 컴퓨터에서는 파일 경로, 배포 서버에서는 파일 내용을 서비스 설정 화면에 직접 입력
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_KEY=
# 강사가 제공한 Azure AI 연결. AZURE_API_KEY는 비밀값이므로 서비스 설정 화면에 직접 입력
AZURE_API_STYLE=openai-v1
AZURE_ENDPOINT=
AZURE_DEPLOYMENT=
AZURE_API_KEY=
